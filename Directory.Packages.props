<Project>

  <!--
    Central Package Management: a versão de cada pacote é declarada uma única vez, aqui.
  -->

  <!--
    Componentes TEC.* consumidos: versão PUBLICADA no feed tec-interno.
    No csproj use <TecReference Include="TEC.X" />, sem versão.
  -->
  <ItemGroup>
    <PackageVersion Include="TEC.Core" Version="0.0.1" />
  </ItemGroup>

  <!-- Terceiros -->
  <ItemGroup>
    <PackageVersion Include="TUnit" Version="1.74.0" />
  </ItemGroup>

  <!-- Pacotes do ASP.NET Core acompanham a versão do framework (net10.0) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
  </ItemGroup>

</Project>
